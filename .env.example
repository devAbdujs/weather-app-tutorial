# ── Supabase ──────────────────────────────────────────────────────────────────
# Public URL of your Supabase project
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Supabase anon (public) key — safe to expose in client code
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase service role key — NEVER expose publicly, server-only
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Telegram ──────────────────────────────────────────────────────────────────
# Bot token from @BotFather — server-only, never expose
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Bot username (without @) — shown in login widget
NEXT_PUBLIC_BOT_USERNAME=your_bot_username

# Telegram Login Widget / OIDC client ID (usually same as bot numeric ID)
NEXT_PUBLIC_TELEGRAM_CLIENT_ID=your_telegram_client_id

# Telegram OIDC client secret — server-only
TELEGRAM_CLIENT_SECRET=your_telegram_client_secret

# ── AI / Gemini ───────────────────────────────────────────────────────────────
# Add as many Gemini API keys as needed for round-robin rotation.
# Keys are auto-detected by the 'gemini_api_key' prefix (case-insensitive).
gemini_api_key1=your_gemini_api_key_1
gemini_api_key2=your_gemini_api_key_2
# gemini_api_key3=your_gemini_api_key_3  (add more as needed)

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Cloudinary cloud name — used to build question image CDN URLs
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Cloudinary API credentials — server-only, used for admin image uploads
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── App ───────────────────────────────────────────────────────────────────────
# Public URL of the deployed app (used for Telegram OIDC redirect URIs)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Database ──────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string (for Supabase CLI migrations only)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
